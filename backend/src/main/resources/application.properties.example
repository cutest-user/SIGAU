spring.application.name=sigau
spring.jpa.open-in-view=false
# Conexion a MySQL
spring.datasource.url=${SIGAU_DB_URL:jdbc:mysql://localhost:3306/sigau}
spring.datasource.username=${SIGAU_DB_USER:root}
spring.datasource.password=${DB_PASSWORD}

# Configuracion de JPA
spring.jpa.hibernate.ddl-auto=${SIGAU_DDL_AUTO:none}
spring.jpa.show-sql=${SIGAU_SHOW_SQL:false}

# Origenes permitidos para el frontend (separados por coma)
sigau.cors.origenes=${SIGAU_CORS_ORIGENES:http://localhost:5173}
